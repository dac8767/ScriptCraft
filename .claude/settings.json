{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(cd *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sed -n *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(curl *)",
      "mcp__Claude_Code_Remote"
    ],
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/coverage/**)",
      "Read(**/src-tauri/target/**)",
      "Read(**/package-lock.json)",
      "Read(**/*.min.js)",
      "Read(**/*.min.css)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node frontend/devtools/check-fresh.mjs || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
